<!DOCTYPE html>
<html>
<head>
  <title>Lacak Lokasi</title>
</head>
<body>
  <h1>Coba Lacak Lokasi</h1>
  <button onclick="getLocation()">Klik untuk lacak lokasi</button>

  <script>
    function getLocation() {
      if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(showPosition, showError);
      } else {
        console.log("Geolocation is not supported by this browser.");
      }
    }

    function showPosition(position) {
      console.log("Latitude: " + position.coords.latitude);
      console.log("Longitude: " + position.coords.longitude);
      alert("Lokasi kamu: " + position.coords.latitude + ", " + position.coords.longitude);
      
      // Kalau mau kirim ke server, bisa tambahkan fetch di sini
      /*
      fetch('/save-location', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          lat: position.coords.latitude,
          lng: position.coords.longitude
        })
      });
      */
    }

    function showError(error) {
      switch(error.code) {
        case error.PERMISSION_DENIED:
          console.log("User denied the request for Geolocation.");
          break;
        case error.POSITION_UNAVAILABLE:
          console.log("Location information is unavailable.");
          break;
        case error.TIMEOUT:
          console.log("The request to get user location timed out.");
          break;
        case error.UNKNOWN_ERROR:
          console.log("An unknown error occurred.");
          break;
      }
    }
  </script>
</body>
</html>
